{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PostgresOptions": {
    "ConnectionString": "Server=localhost;Port=5432;Database=reviews;User Id=postgres;Password=postgres;Include Error Detail=true",
    "UseInMemory": false
  },
  "AgentFrameworkOptions": {
    "ChatProviderType": "OpenAI",
    "EmbeddingProviderType": "OpenAI",
    "ChatEndpoint": "https://api.deepseek.com/v1",
    "EmbeddingEndpoint": "https://api.deepseek.com/v1",
    "ChatDeploymentName": "deepseek-v4-flash",
    "ChatModel": "deepseek-v4-flash",
    "EmbeddingDeploymentName": "deepseek-v4-flash",
    "EmbeddingModel": "deepseek-v4-flash",
    "Temperature": 0.2,
    "SearchThreshold": 0.4,
    "MaximumInvocationCount": 10
  },
  // will overiide by aspire if we use apire
  "Services": {
    "catalogs-api": {
      "https": ["https://localhost:5001"],
      "http": ["http://localhost:5000"]
    }
  }
}
