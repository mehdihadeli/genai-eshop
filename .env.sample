# Copy to .env and replace placeholder values.
# Never commit .env or real credentials.

# AI provider selection. DeepSeek uses the OpenAI-compatible provider.
AgentFrameworkOptions__ChatProviderType=OpenAI
AgentFrameworkOptions__EmbeddingProviderType=OpenAI

# Chat provider. DeepSeek supports chat completions but not embeddings.
AgentFrameworkOptions__ChatEndpoint=https://api.deepseek.com/v1
# Set real API keys only in your local .env file.
AgentFrameworkOptions__ChatApiKey=test
AgentFrameworkOptions__ChatDeploymentName=deepseek-v4-flash
AgentFrameworkOptions__ChatModel=deepseek-v4-flash

# Embedding provider. Use a provider and model that support embeddings.
AgentFrameworkOptions__EmbeddingEndpoint=https://api.openai.com/v1
AgentFrameworkOptions__EmbeddingApiKey=test
AgentFrameworkOptions__EmbeddingDeploymentName=text-embedding-3-small
AgentFrameworkOptions__EmbeddingModel=text-embedding-3-small

# Optional agent behavior settings.
AgentFrameworkOptions__Temperature=0.2
AgentFrameworkOptions__SearchThreshold=0.4
AgentFrameworkOptions__MaximumInvocationCount=10

# Optional running-service URLs for integration and end-to-end tests.
GENAI_TEST_CATALOGS_BASE_URL=http://localhost:5000
GENAI_TEST_CARTS_BASE_URL=http://localhost:4000
GENAI_TEST_ORDERS_BASE_URL=http://localhost:7000
GENAI_TEST_RECOMMENDATION_BASE_URL=http://localhost:2000
GENAI_TEST_REVIEWS_BASE_URL=http://localhost:8000
