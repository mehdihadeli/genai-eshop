<Project>
  <Import Project="..\Directory.Packages.props" />
  <PropertyGroup>
    <IsPublishable>false</IsPublishable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Label="Testing">
